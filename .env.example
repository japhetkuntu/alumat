# Copy this file to .env and fill in any secrets before running the stack.
# You can leave the defaults as-is for local development.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=AlumniDb
POSTGRES_PORT=5432

# Design-time EF migrations connection string (never committed, set locally)
# export ALUMNI_CONNECTION="Host=localhost;Port=5432;Database=AlumniDb;Username=admin;Password=<your-password>;SearchPath=alumni"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── MinIO (local object storage) ──────────────────────────────────────────────
MINIO_ROOT_USER=your-minio-user
MINIO_ROOT_PASSWORD=your-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=alumat

# ── Storage (set to DO Spaces / S3 values in production) ──────────────────────
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://minio:9000
STORAGE_CDN_ENDPOINT=http://minio:9000

# ── Mailtrap (transactional email) ────────────────────────────────────────────
MAILTRAP_API_KEY=your-mailtrap-api-token
MAIL_SENDER_NAME="Your Institution Alumni"
MAIL_SENDER_EMAIL=noreply@example.com

# ── Arkesel (SMS) ──────────────────────────────────────────────────────────────
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=YourOrg

# ── WaSenderAPI (WhatsApp) ───────────────────────────────────────────────────
WASENDER_API_KEY=your-wasender-api-key

# ── JWT Signing Keys (generate with: openssl rand -hex 32) ───────────────────
JWT_ISSUER=https://yourplatform.example
JWT_AUDIENCE=https://yourplatform.example
INSTITUTION_SIGNING_KEY=replace-with-openssl-rand-hex-32
MEMBER_SIGNING_KEY=replace-with-openssl-rand-hex-32
PLATFORM_SIGNING_KEY=replace-with-openssl-rand-hex-32
# How long an access token is valid for (hours) and how long a session/refresh
# token lasts before a user is forced to log in again (days).
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ── Multi-tenancy (platform SaaS domain — see docs/FUNCTIONAL_REQUIREMENTS.md) ─
# Inert until you register this domain and point wildcard DNS/SSL at it; every
# request falls back to DEFAULT_INSTITUTION_SLUG until then.
PLATFORM_BASE_DOMAIN=yourplatform.example
DEFAULT_INSTITUTION_SLUG=your-institution-slug

# ── Paystack (get from dashboard.paystack.com) ────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
PAYSTACK_CALLBACK_URL=http://localhost:3200/contributions

# ── Frontend API URLs (baked into the JS bundle at build time) ────────────────
NEXT_PUBLIC_INSTITUTION_API_URL=http://localhost:5100/api/v1
NEXT_PUBLIC_MEMBER_API_URL=http://localhost:5200/api/v1
