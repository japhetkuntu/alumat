{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "institution-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev:institution"
      ],
      "port": 4100
    },
    {
      "name": "platform-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev:platform"
      ],
      "port": 3300
    },
    {
      "name": "member-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev:member"
      ],
      "port": 3200
    },
    {
      "name": "platform-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/src/ReservEase.Alumni.Platform.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5300
    },
    {
      "name": "member-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/src/ReservEase.Alumni.Member.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5200
    },
    {
      "name": "institution-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/src/ReservEase.Alumni.Institution.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5100
    }
  ]
}