# Copy this file to .env and populate ALL secrets before running the stack.
# Do NOT commit .env to source control.
#
# ── Deployment mode ───────────────────────────────────────────────────────────
# IP mode (no domain yet): uses nginx.ip.conf with port-based routing.
# Domain mode (after DNS + SSL): remove NGINX_CONF_FILE line entirely.
NGINX_CONF_FILE=./docker/nginx/nginx.ip.conf
SERVER_IP=YOUR_SERVER_IP
ENABLE_SWAGGER=false
USE_HTTPS_REDIRECT=false

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=AlumniDb
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=alumat

# ── Storage (set STORAGE_CDN_ENDPOINT to public URL for file serving) ─────────
STORAGE_ACCESS_KEY=CHANGE_ME_MINIO_USER
STORAGE_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
STORAGE_BUCKET=alumat
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://alumni-minio:9000
STORAGE_CDN_ENDPOINT=https://cdn.yourplatform.example
# Leave blank if STORAGE_BUCKET above is dedicated to this project only. Set
# it if the bucket is shared with other, unrelated projects — every object
# key gets this as a top-level prefix so nothing collides.
STORAGE_ROOT_FOLDER=

# ── JWT Signing Keys (generate with: openssl rand -hex 32) ───────────────────
JWT_ISSUER=https://yourplatform.example
JWT_AUDIENCE=https://yourplatform.example
INSTITUTION_SIGNING_KEY=CHANGE_ME_replace_with_secure_random_key_64chars
MEMBER_SIGNING_KEY=CHANGE_ME_replace_with_secure_random_key_64chars
PLATFORM_SIGNING_KEY=CHANGE_ME_replace_with_secure_random_key_64chars
# How long an access token is valid for (hours) and how long a session/refresh
# token lasts before a user is forced to log in again (days).
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ── Multi-tenancy (platform SaaS domain — see docs/FUNCTIONAL_REQUIREMENTS.md) ─
# Every institution's Slug resolves to a real subdomain once wildcard DNS/SSL
# point at this server and NGINX_CONF_FILE below is switched to
# nginx.wildcard.conf: {slug}.PLATFORM_BASE_DOMAIN (member portal) and
# {slug}.admin.PLATFORM_BASE_DOMAIN (institution portal) — docker-compose.prod.yml
# already derives the "admin." variant for Institution.Api from this one value.
# Until then, every request falls back to DEFAULT_INSTITUTION_SLUG, same as before.
PLATFORM_BASE_DOMAIN=yourplatform.example
DEFAULT_INSTITUTION_SLUG=your-institution-slug

# ── Mailtrap (transactional email) ────────────────────────────────────────────
# API key from your Mailtrap account's Sending Domains / API Tokens page.
MAILTRAP_API_KEY=your-mailtrap-api-token
MAIL_SENDER_NAME="Your Institution Alumni"
MAIL_SENDER_EMAIL=noreply@yourplatform.example

# ── Arkesel (SMS) ──────────────────────────────────────────────────────────────
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=YourOrg

# ── WaSenderAPI (WhatsApp) ───────────────────────────────────────────────────
WASENDER_API_KEY=your-wasender-api-key

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxx
PAYSTACK_CALLBACK_URL=https://yourplatform.example/contributions
# Zero-Deduction gross-up — optional, these are the defaults if omitted.
# Verify against Paystack's current published GHS rate before relying on it.
PAYSTACK_GATEWAY_FEE_PERCENTAGE=1.95
PAYSTACK_GATEWAY_FIXED_FEE_SUBUNIT=0
PAYSTACK_GATEWAY_FEE_SAFETY_BUFFER_SUBUNIT=2

# ── Frontend API URLs (baked into JS bundles at build time) ───────────────────
# IP mode — use IP:port values below.
# Domain mode — uncomment the https:// lines and remove the http:// ones.
NEXT_PUBLIC_INSTITUTION_API_URL=http://YOUR_SERVER_IP:8002/api/v1
NEXT_PUBLIC_MEMBER_API_URL=http://YOUR_SERVER_IP:8003/api/v1
# NEXT_PUBLIC_INSTITUTION_API_URL=https://admin.yourplatform.example/api/v1
# NEXT_PUBLIC_MEMBER_API_URL=https://api.yourplatform.example/api/v1

# ── Domain mode, single fixed institution (uncomment when DNS is live and SSL is provisioned) ─
# NGINX_CONF_FILE=   ← remove this line entirely
# JWT_ISSUER=https://yourplatform.example
# JWT_AUDIENCE=https://yourplatform.example
# PAYSTACK_CALLBACK_URL=https://yourplatform.example/contributions
# NEXT_PUBLIC_INSTITUTION_API_URL=https://admin.yourplatform.example/api/v1
# NEXT_PUBLIC_MEMBER_API_URL=https://api.yourplatform.example/api/v1
# STORAGE_CDN_ENDPOINT=https://cdn.yourplatform.example

# ── Wildcard mode, per-institution subdomains (see docker/nginx/nginx.wildcard.conf) ─
# Every institution gets its own {slug}.PLATFORM_BASE_DOMAIN / {slug}.admin.PLATFORM_BASE_DOMAIN
# automatically — no per-institution nginx or .env change needed.
# NGINX_CONF_FILE=./docker/nginx/nginx.wildcard.conf
# JWT_ISSUER=https://yourplatform.example
# JWT_AUDIENCE=https://yourplatform.example
# PAYSTACK_CALLBACK_URL=https://yourplatform.example/contributions
# STORAGE_CDN_ENDPOINT=https://cdn.yourplatform.example
# Leave NEXT_PUBLIC_INSTITUTION_API_URL / NEXT_PUBLIC_MEMBER_API_URL / NEXT_PUBLIC_PLATFORM_API_URL
# UNSET here — same-origin "/api/v1" is what makes one Docker image work for
# every institution's subdomain (see each app's src/lib/api-client.ts comment).
# Requires two wildcard TLS certs — see the prerequisites comment at the top
# of nginx.wildcard.conf — and PLATFORM_BASE_DOMAIN set above to your real domain.
