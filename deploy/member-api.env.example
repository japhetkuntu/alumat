# Copy to /etc/alumunion/member-api.env on the droplet (chmod 600, root-owned —
# this is systemd's EnvironmentFile, plain KEY=VALUE, no quotes, no `export`).
# Keys use ASP.NET Core's double-underscore convention for nested config
# (Foo:Bar -> Foo__Bar), same as appsettings.json.

# --- Database / cache (Postgres/Redis installed natively — see install.sh) ---
ConnectionStrings__AlumniConnection=Host=localhost;Port=5432;Database=AlumniDb;Username=alumni;Password=REPLACE_WITH_THE_PASSWORD_YOU_SET_IN_INSTALL_SH;SearchPath=alumni
Redis__MemberRedisConfig__ConnectionString=localhost:6379
Redis__MemberRedisConfig__DbNumber=1

# --- Multi-tenancy — bare domain, the member-facing memorable one. Institution.Api
# gets the "admin." prefixed variant so the two never collide.
PlatformBaseDomain=yourdomain.com
DefaultInstitutionSlug=your-institution-slug

# --- JWT signing keys (generate each with: openssl rand -base64 48) -----------
# Must be the exact same values used in institution-api.env / platform-api.env's
# matching keys.
BearerTokenConfig__Issuer=https://yourdomain.com
BearerTokenConfig__Audience=https://yourdomain.com
BearerTokenConfig__InstitutionSigningKey=
BearerTokenConfig__MemberSigningKey=

# --- Online payments (Paystack — never exposed to users as "Paystack" in the UI,
# see the platform's own copy for that; this is just the processor underneath) ---
PaystackConfig__SecretKey=sk_live_xxxx
PaystackConfig__PublicKey=pk_live_xxxx
PaystackConfig__CallbackUrl=https://yourdomain.com/contributions

# --- Email via Mailtrap Send API -----------------------------------------------
MailtrapConfig__ApiKey=
MailtrapConfig__DefaultMessageSource__Name="Your Institution Alumni"
MailtrapConfig__DefaultMessageSource__Email=noreply@yourdomain.com

# --- SMS (Arkesel) --------------------------------------------------------------
ArkeselConfig__ApiKey=
ArkeselConfig__SenderId=YourOrg

# --- WhatsApp (WaSenderAPI) ------------------------------------------------------
# Leave empty to fall back to logging instead of sending.
WaSenderConfig__ApiKey=

# --- DigitalOcean Spaces (member uploads, campaign proofs) ----------------------
# Same bucket as institution-api.env / platform-api.env.
StorageConfig__AccessKey=
StorageConfig__SecretKey=
StorageConfig__BucketName=alumunion
StorageConfig__Region=fra1
StorageConfig__Endpoint=https://fra1.digitaloceanspaces.com
StorageConfig__CdnEndpoint=https://alumunion.fra1.cdn.digitaloceanspaces.com
# Leave blank if this bucket is dedicated to this project only. Set it if
# BucketName above is shared with other, unrelated projects — every object
# key gets this as a top-level prefix so nothing collides. Must match
# institution-api.env / platform-api.env's value exactly (same bucket).
StorageConfig__RootFolder=

# --- Optional (both default to false if unset) ---------------------------------
# ENABLE_SWAGGER=false
# USE_HTTPS_REDIRECT=false
