# Public build settings for the platform app, used by the Build workflow (.github/workflows/build.yml).
#
# Next.js writes NEXT_PUBLIC_* values into the JavaScript every visitor downloads, so they are public by definition and
# safe to keep in the repository. They must match the same lines in the server's
# frontend/apps/platform/.env.production.local. Only NEXT_PUBLIC_ lines are read; never put a secret here.
NEXT_PUBLIC_GOOGLE_AUTH_URL=https://alumunion.com/google-auth
NEXT_PUBLIC_BASE_DOMAIN=alumunion.com
