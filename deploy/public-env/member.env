# Public build settings for the member app, used by the Build workflow (.github/workflows/build.yml).
#
# Next.js writes NEXT_PUBLIC_* values into the JavaScript every visitor downloads, so they are public by definition and
# safe to keep in the repository. They must match the same lines in the server's
# frontend/apps/member/.env.production.local. Only NEXT_PUBLIC_ lines are read; never put a secret here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=226824056804-al8uv8a2r8j4von8ist370j3a3gbjcfi.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_AUTH_URL=/google-auth
NEXT_PUBLIC_BASE_DOMAIN=alumunion.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5NWFZBYG1G
NEXT_PUBLIC_GOOGLE_AUTO_REDIRECT=false
