[Unit]
Description=Alumni Portal Member API
After=network.target postgresql.service redis-server.service alumni-institution-api.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/alumunion/member-api
ExecStart=/usr/bin/dotnet /var/www/alumunion/member-api/ReservEase.Alumni.Member.Api.dll
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStartSec=300
SyslogIdentifier=alumni-member-api
StandardOutput=journal
StandardError=journal

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5002
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
EnvironmentFile=/etc/alumunion/member-api.env

[Install]
WantedBy=multi-user.target
