# Copy to /etc/alumunion/operations-worker.env on the droplet (chmod 600,
# root-owned — this is systemd's EnvironmentFile, plain KEY=VALUE, no quotes,
# no `export`). Keys use ASP.NET Core's double-underscore convention for
# nested config (Foo:Bar -> Foo__Bar), same as appsettings.json.
#
# This worker runs the same domain services (StoreOrderService,
# ServiceRequestService, ContributionService) that member-api's payment
# callback controller used to run in-process — same database, same gateway/
# notification credentials. Copy the matching values straight out of
# member-api.env; do not invent new ones (they must point at the same
# Postgres, Redis, Paystack, storage bucket, SMS and WhatsApp accounts).

# --- Database / cache (same values as member-api.env) --------------------
ConnectionStrings__AlumniConnection=Host=localhost;Port=5432;Database=AlumniDb;Username=alumni;Password=REPLACE_WITH_THE_PASSWORD_YOU_SET_IN_INSTALL_SH;SearchPath=alumni

# Optional: only needed if ConnectionStrings__AlumniConnection above points at a connection
# pool (e.g. a DigitalOcean managed Connection Pool / PgBouncer) instead of Postgres directly.
# Startup migrations need a DIRECT connection — pools don't expose the cluster's maintenance
# database used to check/create AlumniDb, and the advisory lock that serializes migrations
# across services needs one physical connection held for its duration, which a pool doesn't
# guarantee. Leave unset if AlumniConnection above is already a direct connection.
# ConnectionStrings__AlumniMigrationConnection=Host=localhost;Port=5432;Database=AlumniDb;Username=alumni;Password=REPLACE_WITH_THE_PASSWORD_YOU_SET_IN_INSTALL_SH;SearchPath=alumni
Redis__MemberRedisConfig__ConnectionString=localhost:6379
Redis__MemberRedisConfig__DbNumber=1

# --- Multi-tenancy — this worker builds every notification's ActionUrl
# (see NotificationDispatchActivities.LoadInstitutionAsync) and every
# templated email's portal links from these two, so they must be set or
# every such link falls back to the appsettings.json placeholder
# "yourplatform.example". MemberPortalBaseDomain must match member-api.env's
# PlatformBaseDomain exactly (bare domain); AdminPortalBaseDomain must match
# institution-api.env's PlatformBaseDomain exactly ("admin." prefixed).
MemberPortalBaseDomain=yourdomain.com
AdminPortalBaseDomain=admin.yourdomain.com
# Full URL of the Platform Portal — the weekly activation digest email links to
# its /activation page. Leave empty to send the digest without a link.
PlatformPortalUrl=https://platform.yourdomain.com

# --- Online payments (Paystack — same values as member-api.env) ----------
PaystackConfig__SecretKey=sk_live_xxxx
PaystackConfig__PublicKey=pk_live_xxxx
PaystackConfig__CallbackUrl=https://yourdomain.com/contributions
PaystackConfig__GatewayFeePercentage=1.95
PaystackConfig__GatewayFixedFeeSubunit=0
PaystackConfig__GatewayFeeSafetyBufferSubunit=2

# --- SMS (Arkesel — same values as member-api.env) ------------------------
ArkeselConfig__ApiKey=
ArkeselConfig__SenderId=YourOrg

# --- WhatsApp (WaSenderAPI — same values as member-api.env) ---------------
# Leave empty to fall back to logging instead of sending.
WaSenderConfig__ApiKey=

# --- Temporal Cloud --------------------------------------------------------
# Create a namespace and API key in the Temporal Cloud console first — this
# repo cannot do that for you. Same three values go in member-api.env too
# (Member.Api only ever *starts* workflows; this worker is what *runs* them).
# Address is "<namespace>.<account-id>.tmprl.cloud:7233" — copy it verbatim
# from the namespace's page in the Temporal Cloud console.
TemporalConfig__Address=your-namespace.a1b2c3.tmprl.cloud:7233
TemporalConfig__Namespace=your-namespace.a1b2c3
TemporalConfig__ApiKey=

# --- Web push notifications (VAPID) --------------------------------------------
# ONE keypair for the whole platform; the same three values must be set in
# member-api.env, institution-api.env and operations-worker.env. The public key is
# handed to browsers by the two APIs; the worker signs and sends pushes with the
# private key. Generate once with:  npx web-push generate-vapid-keys
# Keep the private key secret. Changing the pair later drops every existing
# browser subscription (people would need to turn notifications on again).
WebPushConfig__VapidPublicKey=
WebPushConfig__VapidPrivateKey=
WebPushConfig__VapidSubject=mailto:ops@yourdomain.com

# --- DigitalOcean Spaces (generated reports) -----------------------------------
# The worker writes finished report files here, privately (no public URL); the
# Institution and Platform APIs read them back when the requester downloads one.
# Use the SAME bucket and RootFolder as those two APIs, or they won't find the file.
StorageConfig__AccessKey=
StorageConfig__SecretKey=
StorageConfig__BucketName=alumunion
StorageConfig__Region=fra1
StorageConfig__Endpoint=https://fra1.digitaloceanspaces.com
StorageConfig__RootFolder=
