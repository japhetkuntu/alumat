[Unit]
Description=Alumni Portal Institution API
# The one that applies EF Core migrations on boot first, by convention —
# member-api/platform-api share the same migrations project, so ordering
# after this one avoids a race on the very first (empty-database) boot.
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/alumunion/institution-api
ExecStart=/usr/bin/dotnet /var/www/alumunion/institution-api/ReservEase.Alumni.Institution.Api.dll
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStartSec=300
SyslogIdentifier=alumni-institution-api
StandardOutput=journal
StandardError=journal

Environment=ASPNETCORE_ENVIRONMENT=Production
# Loopback-only — Nginx is the only thing that talks to this port, never the internet.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5001
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
EnvironmentFile=/etc/alumunion/institution-api.env

[Install]
WantedBy=multi-user.target
