# Copy to frontend/apps/institution/.env.production.local on the droplet
# (inside the git-cloned source tree at /opt/alumunion-src, but gitignored —
# `git pull` in deploy.sh never touches or removes it, so create this once
# and it survives every future redeploy).
#
# Next.js bakes NEXT_PUBLIC_* values into the JS bundle at build time, not
# runtime — this file only matters at the moment `pnpm build` runs, which is
# why it has to exist BEFORE the first deploy/deploy.sh.
#
# NEXT_PUBLIC_INSTITUTION_API_URL is deliberately NOT set here — this
# droplet setup uses one wildcard domain with same-origin "/api/v1" routing
# (see nginx.conf), which is what lets a single build serve every
# institution's subdomain. Setting it would hardcode every tenant to one
# fixed API host and break that.

# --- Google sign-in (optional — leave blank to hide the button) --------------
# Full URL of the shared Google sign-in bridge, hosted by the member app (the
# one portal on a fixed, non-tenant domain — see apps/member/src/app/google-auth).
# Institution staff login just redirects here.
NEXT_PUBLIC_GOOGLE_AUTH_URL=https://yourdomain.com/google-auth
