# Copy to /etc/alumunion/institution-api.env on the droplet (chmod 600, root-owned
# — this is systemd's EnvironmentFile, plain KEY=VALUE, no quotes, no `export`).
# Keys use ASP.NET Core's double-underscore convention for nested config
# (Foo:Bar -> Foo__Bar), same as appsettings.json.

# --- Database / cache (Postgres/Redis installed natively — see install.sh) ---
ConnectionStrings__AlumniConnection=Host=localhost;Port=5432;Database=AlumniDb;Username=alumni;Password=REPLACE_WITH_THE_PASSWORD_YOU_SET_IN_INSTALL_SH;SearchPath=alumni

# Optional: only needed if ConnectionStrings__AlumniConnection above points at a connection
# pool (e.g. a DigitalOcean managed Connection Pool / PgBouncer) instead of Postgres directly.
# Startup migrations need a DIRECT connection — pools don't expose the cluster's maintenance
# database used to check/create AlumniDb, and the advisory lock that serializes migrations
# across services needs one physical connection held for its duration, which a pool doesn't
# guarantee. Leave unset if AlumniConnection above is already a direct connection.
# ConnectionStrings__AlumniMigrationConnection=Host=localhost;Port=5432;Database=AlumniDb;Username=alumni;Password=REPLACE_WITH_THE_PASSWORD_YOU_SET_IN_INSTALL_SH;SearchPath=alumni
Redis__InstitutionRedisConfig__ConnectionString=localhost:6379
Redis__InstitutionRedisConfig__DbNumber=0
Redis__PublicContentCacheConfig__ConnectionString=localhost:6379
Redis__PublicContentCacheConfig__DbNumber=3
Redis__TenantResolutionCacheConfig__ConnectionString=localhost:6379
Redis__TenantResolutionCacheConfig__DbNumber=4

# --- Multi-tenancy — MUST be "admin." prefixed, distinct from member-api's bare
# domain, so {slug}.admin.yourdomain.com and {slug}.yourdomain.com never collide.
PlatformBaseDomain=admin.yourdomain.com
DefaultInstitutionSlug=your-institution-slug
# The Member Portal's bare base domain — used ONLY to build the shareable
# "your member portal" link shown to institution staff (Settings > Domain).
# Never used for tenant resolution; must match member-api.env's
# PlatformBaseDomain exactly.
MemberPortalBaseDomain=yourdomain.com

# --- JWT signing keys (generate each with: openssl rand -base64 48) -----------
# Institution.Api validates both — must be the exact same values used in
# member-api.env and platform-api.env's matching keys.
BearerTokenConfig__Issuer=https://yourdomain.com
BearerTokenConfig__Audience=https://yourdomain.com
BearerTokenConfig__InstitutionSigningKey=
BearerTokenConfig__MemberSigningKey=

# --- Google sign-in (optional — leave ClientId blank to keep password-only login) ---
# Same Client ID as member-api.env / platform-api.env — see that file's
# comment for what this is and why no client secret is needed.
GoogleAuthConfig__ClientId=

# --- Email via Mailtrap Send API -----------------------------------------------
# Sending API token from your Mailtrap account (Sending Domains -> API Tokens).
MailtrapConfig__ApiKey=
MailtrapConfig__DefaultMessageSource__Name="Your Institution Alumni"
MailtrapConfig__DefaultMessageSource__Email=noreply@yourdomain.com

# --- DigitalOcean Spaces (logos, uploaded documents) ---------------------------
# BucketName can be shared with the other two APIs — they all write here.
StorageConfig__AccessKey=
StorageConfig__SecretKey=
StorageConfig__BucketName=alumunion
StorageConfig__Region=fra1
StorageConfig__Endpoint=https://fra1.digitaloceanspaces.com
# CDN endpoint is optional — only set if you've enabled the Spaces CDN.
StorageConfig__CdnEndpoint=https://alumunion.fra1.cdn.digitaloceanspaces.com
# Leave blank if this bucket is dedicated to this project only. Set it if
# BucketName above is shared with other, unrelated projects (e.g. one Spaces
# bucket reused across several apps) — every object key gets this as a
# top-level prefix so nothing collides. Same convention as WishDem's
# Storage__RootFolder.
# MUST be identical in the Member, Institution, Platform APIs and the Operations Worker: it decides where in the bucket files are
# written and read. (Downloads of finished reports also look in the other likely places, so a mismatch no longer loses a report.)
StorageConfig__RootFolder=
# DigitalOcean Spaces CDN endpoints already embed the bucket in the hostname
# (bucket.region.cdn.digitaloceanspaces.com) - keep this false or URLs 404.
StorageConfig__CdnUrlIncludesBucket=false

# --- Optional (both default to false if unset) ---------------------------------
# ENABLE_SWAGGER=false
# USE_HTTPS_REDIRECT=false

# --- Web push notifications (VAPID) --------------------------------------------
# ONE keypair for the whole platform; the same three values must be set in
# member-api.env, institution-api.env and operations-worker.env. The public key is
# handed to browsers by the two APIs; the worker signs and sends pushes with the
# private key. Generate once with:  npx web-push generate-vapid-keys
# Keep the private key secret. Changing the pair later drops every existing
# browser subscription (people would need to turn notifications on again).
WebPushConfig__VapidPublicKey=
WebPushConfig__VapidPrivateKey=
WebPushConfig__VapidSubject=mailto:ops@yourdomain.com
