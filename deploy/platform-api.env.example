# Copy to /etc/alumunion/platform-api.env on the droplet (chmod 600, root-owned —
# this is systemd's EnvironmentFile, plain KEY=VALUE, no quotes, no `export`).
# Keys use ASP.NET Core's double-underscore convention for nested config
# (Foo:Bar -> Foo__Bar), same as appsettings.json.

# --- Database / cache (Postgres/Redis installed natively — see install.sh) ---
ConnectionStrings__AlumniConnection=Host=localhost;Port=5432;Database=AlumniDb;Username=alumni;Password=REPLACE_WITH_THE_PASSWORD_YOU_SET_IN_INSTALL_SH;SearchPath=alumni
Redis__PlatformRedisConfig__ConnectionString=localhost:6379
Redis__PlatformRedisConfig__DbNumber=2

# --- Multi-tenancy — Platform.Api doesn't itself resolve a tenant per request
# (it operates across every institution), these are mostly informational.
PlatformBaseDomain=yourdomain.com
DefaultInstitutionSlug=your-institution-slug

# --- JWT signing key (generate with: openssl rand -base64 48) -----------------
BearerTokenConfig__Issuer=https://yourdomain.com
BearerTokenConfig__Audience=https://yourdomain.com
BearerTokenConfig__PlatformSigningKey=

# --- Online payments (Paystack) — subaccount creation for institution payouts ---
PaystackConfig__BaseUrl=https://api.paystack.co
PaystackConfig__SecretKey=sk_live_xxxx
PaystackConfig__PublicKey=pk_live_xxxx
PaystackConfig__CallbackUrl=https://yourdomain.com/contributions

# --- DigitalOcean Spaces (institution logos uploaded during onboarding) ---------
# Same bucket as institution-api.env / member-api.env.
StorageConfig__AccessKey=
StorageConfig__SecretKey=
StorageConfig__BucketName=alumunion
StorageConfig__Region=fra1
StorageConfig__Endpoint=https://fra1.digitaloceanspaces.com
StorageConfig__CdnEndpoint=https://alumunion.fra1.cdn.digitaloceanspaces.com

# --- Optional (both default to false if unset) ---------------------------------
# ENABLE_SWAGGER=false
# USE_HTTPS_REDIRECT=false
