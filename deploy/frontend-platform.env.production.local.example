# Copy to frontend/apps/platform/.env.production.local on the droplet (inside
# the git-cloned source tree at /opt/alumunion-src, but gitignored — `git
# pull` in deploy.sh never touches or removes it, so create this once and it
# survives every future redeploy).
#
# Next.js bakes NEXT_PUBLIC_* values into the JS bundle at build time, not
# runtime — this file only matters at the moment `pnpm build` runs, which is
# why it has to exist BEFORE the first deploy/deploy.sh.

# --- Google sign-in (optional — leave blank to hide the button) --------------
# The shared Google sign-in bridge is hosted by the member app, on the one
# fixed, non-tenant domain (see apps/member/src/app/google-auth). Platform
# staff login always links to https://<this>/google-auth. Same value as
# NEXT_PUBLIC_BASE_DOMAIN in frontend/apps/member's env.
NEXT_PUBLIC_BASE_DOMAIN=yourdomain.com
