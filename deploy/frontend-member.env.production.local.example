# Copy to frontend/apps/member/.env.production.local on the droplet (inside
# the git-cloned source tree at /opt/alumunion-src, but gitignored — `git
# pull` in deploy.sh never touches or removes it, so create this once and it
# survives every future redeploy).
#
# Next.js bakes NEXT_PUBLIC_* values into the JS bundle at build time, not
# runtime — unlike the backend's *-api.env files (systemd EnvironmentFile,
# read every process start), this file only matters at the moment
# `pnpm build` runs, which is why it has to exist BEFORE the first
# deploy/deploy.sh, not just before the services start.
#
# NEXT_PUBLIC_MEMBER_API_URL / NEXT_PUBLIC_INSTITUTION_API_URL are
# deliberately NOT set here — this droplet setup uses one wildcard domain
# with same-origin "/api/v1" routing (see nginx.conf), which is what lets a
# single build serve every institution's subdomain. Setting either would
# hardcode every tenant to one fixed API host and break that.

# --- Google sign-in (optional — leave both blank to hide the button) ---------
# The member app hosts the shared Google sign-in bridge for ALL THREE portals
# (see apps/member/src/app/google-auth) — it's the one app on a fixed,
# non-tenant domain, so it's the only origin registered with Google.
#
# OAuth 2.0 "Web application" Client ID from Google Cloud Console — same
# value as GoogleAuthConfig__ClientId in member-api.env / institution-api.env
# / platform-api.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Where this app's own bridge page lives — always relative here since the
# bridge is part of this same app.
NEXT_PUBLIC_GOOGLE_AUTH_URL=/google-auth
